generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("URL_PRODUCCION")
}

// ============================================================
// ENUMS
// ============================================================

enum RolUsuario {
  admin
  ayudante
}

enum EstadoPedido {
  acumulando
  empaquetado
  en_agencia
  recibido
  cancelado
}

enum TipoMovimientoStock {
  compra
  venta
  ajuste
  anulacion
}

enum TipoMovimientoCaja {
  ingreso
  egreso
  transferencia
  retiro_socio
}

// ============================================================
// USUARIOS, CONFIGURACIÓN Y AUDITORÍA
// ============================================================

model Usuario {
  id           Int        @id @default(autoincrement())
  nombre       String
  username     String     @unique
  passwordHash String
  rol          RolUsuario @default(ayudante)
  activo       Boolean    @default(true)
  creadoEn     DateTime   @default(now())

  ventas     Venta[]
  compras    Compra[]
  auditorias Auditoria[]
  gastos     Gasto[]
}

model Configuracion {
  id            Int      @id @default(autoincrement())
  clave         String   @unique // ej: "costo_empaque_por_paquete"
  valor         String
  descripcion   String?
  actualizadoEn DateTime @updatedAt
}

model Auditoria {
  id           Int      @id @default(autoincrement())
  usuarioId    Int?
  entidad      String // ej: "Venta", "Producto"
  entidadId    Int
  accion       String // ej: "crear", "editar", "anular"
  datosAntes   Json?
  datosDespues Json?
  fecha        DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([entidad, entidadId])
  @@index([fecha])
}

// ============================================================
// CLIENTES, PRODUCTOS Y PROVEEDORES
// ============================================================

model Cliente {
  id             Int      @id @default(autoincrement())
  nombre         String
  apellido       String?
  usuarioTiktok  String?  @unique
  celular        String?
  dni            String?
  departamento   String?
  ciudad         String?
  provincia      String?
  agenciaDestino String?
  notas          String?
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now())

  ventas  Venta[]
  pedidos Pedido[]

  @@index([nombre])
}

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  productos Producto[]
}

model Producto {
  id            Int      @id @default(autoincrement())
  nombre        String
  categoriaId   Int?
  marca         String?
  sku           String?  @unique
  fotoUrl       String?
  costoPromedio Decimal  @default(0) @db.Decimal(12, 4)
  stockActual   Int      @default(0)
  stockMinimo   Int      @default(0)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())

  categoria        Categoria?        @relation(fields: [categoriaId], references: [id])
  ventaItems       VentaItem[]
  compraItems      CompraItem[]
  movimientosStock MovimientoStock[]

  @@index([nombre])
  @@index([categoriaId])
}

model Proveedor {
  id        Int     @id @default(autoincrement())
  nombre    String
  celular   String?
  direccion String?
  notas     String?
  activo    Boolean @default(true)

  compras Compra[]
}

// ============================================================
// COMPRAS (ENTRADA DE STOCK)
// ============================================================

model Compra {
  id                Int       @id @default(autoincrement())
  proveedorId       Int?
  cuentaId          Int? // cuenta de la que salió el dinero
  creadoPorId       Int?
  fecha             DateTime  @default(now())
  gastosAdicionales Decimal   @default(0) @db.Decimal(12, 2)
  total             Decimal   @db.Decimal(12, 2)
  notas             String?
  anulada           Boolean   @default(false)
  anuladaEn         DateTime?
  motivoAnulacion   String?

  proveedor Proveedor? @relation(fields: [proveedorId], references: [id])
  cuenta    Cuenta?    @relation(fields: [cuentaId], references: [id])
  creadoPor Usuario?   @relation(fields: [creadoPorId], references: [id])

  items            CompraItem[]
  movimientosStock MovimientoStock[]
  movimientosCaja  MovimientoCaja[]

  @@index([fecha])
}

model CompraItem {
  id                 Int     @id @default(autoincrement())
  compraId           Int
  productoId         Int
  cantidad           Int
  costoUnitario      Decimal @db.Decimal(12, 4) // precio pagado
  costoUnitarioFinal Decimal @db.Decimal(12, 4) // incluye gastos adicionales prorrateados

  compra   Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([compraId])
  @@index([productoId])
}

// ============================================================
// PEDIDOS (ENVÍOS) Y VENTAS
// ============================================================

model Pedido {
  id                Int          @id @default(autoincrement())
  clienteId         Int
  estado            EstadoPedido @default(acumulando)
  agencia           String?
  codigoSeguimiento String?
  costoEmpaque      Decimal      @default(0) @db.Decimal(12, 2)
  fechaEnvio        DateTime?
  fechaRecepcion    DateTime?
  notas             String?
  creadoEn          DateTime     @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id])
  ventas  Venta[]

  @@index([clienteId, estado])
  @@index([estado])
}

model Venta {
  id              Int       @id @default(autoincrement())
  clienteId       Int
  pedidoId        Int?
  cuentaId        Int? // cuenta donde entró el pago
  creadoPorId     Int?
  fecha           DateTime  @default(now())
  montoPagado     Decimal   @db.Decimal(12, 2) // puede ser 0 (premio, regalo, combo)
  notas           String?
  anulada         Boolean   @default(false)
  anuladaEn       DateTime?
  motivoAnulacion String?

  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  pedido    Pedido?  @relation(fields: [pedidoId], references: [id])
  cuenta    Cuenta?  @relation(fields: [cuentaId], references: [id])
  creadoPor Usuario? @relation(fields: [creadoPorId], references: [id])

  items            VentaItem[]
  movimientosStock MovimientoStock[]
  movimientosCaja  MovimientoCaja[]

  @@index([clienteId])
  @@index([pedidoId])
  @@index([fecha])
}

model VentaItem {
  id                    Int     @id @default(autoincrement())
  ventaId               Int
  productoId            Int
  cantidad              Int
  costoUnitarioSnapshot Decimal @db.Decimal(12, 4) // costo del producto EN ESE MOMENTO

  venta    Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([ventaId])
  @@index([productoId])
}

// ============================================================
// INVENTARIO: MOVIMIENTOS (KARDEX)
// ============================================================

model MovimientoStock {
  id              Int                 @id @default(autoincrement())
  productoId      Int
  tipo            TipoMovimientoStock
  cantidad        Int // positivo = entra, negativo = sale
  stockResultante Int // stock después del movimiento
  ventaId         Int?
  compraId        Int?
  motivo          String? // útil en ajustes (merma, daño, etc.)
  fecha           DateTime            @default(now())

  producto Producto @relation(fields: [productoId], references: [id])
  venta    Venta?   @relation(fields: [ventaId], references: [id])
  compra   Compra?  @relation(fields: [compraId], references: [id])

  @@index([productoId, fecha])
}

// ============================================================
// CAJA Y CUENTAS
// ============================================================

model Cuenta {
  id           Int     @id @default(autoincrement())
  nombre       String  @unique // Efectivo, Yape, Banco...
  saldoInicial Decimal @default(0) @db.Decimal(12, 2)
  activa       Boolean @default(true)

  ventas             Venta[]
  compras            Compra[]
  movimientos        MovimientoCaja[]  @relation("CuentaOrigen")
  movimientosDestino MovimientoCaja[]  @relation("CuentaDestino")
  gastoRecurrentes   GastoRecurrente[]
  gastos             Gasto[]
}

model MovimientoCaja {
  id              Int                @id @default(autoincrement())
  cuentaId        Int // cuenta origen (o única)
  cuentaDestinoId Int? // solo en transferencias
  tipo            TipoMovimientoCaja
  monto           Decimal            @db.Decimal(12, 2) // siempre positivo
  categoria       String?
  descripcion     String?
  ventaId         Int?
  compraId        Int?
  fecha           DateTime           @default(now())
  anulado         Boolean            @default(false)
  anuladoEn       DateTime?
  motivoAnulacion String?
  gastoId         Int?
  gasto           Gasto?             @relation(fields: [gastoId], references: [id])

  cuenta        Cuenta  @relation("CuentaOrigen", fields: [cuentaId], references: [id])
  cuentaDestino Cuenta? @relation("CuentaDestino", fields: [cuentaDestinoId], references: [id])
  venta         Venta?  @relation(fields: [ventaId], references: [id])
  compra        Compra? @relation(fields: [compraId], references: [id])

  @@index([cuentaId, fecha])
}

enum TipoGasto {
  fijo
  variable
  sueldo
  otro
}

model CategoriaGasto {
  id                 Int       @id @default(autoincrement())
  nombre             String    @unique
  tipo               TipoGasto
  presupuestoMensual Decimal?  @db.Decimal(12, 2)
  activa             Boolean   @default(true)

  gastos      Gasto[]
  recurrentes GastoRecurrente[]
}

model Empleado {
  id         Int      @id @default(autoincrement())
  nombre     String
  cargo      String?
  sueldoBase Decimal  @db.Decimal(12, 2) // mensual
  activo     Boolean  @default(true)
  creadoEn   DateTime @default(now())

  gastos      Gasto[]
  recurrentes GastoRecurrente[]
}

model GastoRecurrente {
  id           Int      @id @default(autoincrement())
  nombre       String
  categoriaId  Int
  cuentaId     Int
  empleadoId   Int?
  monto        Decimal  @db.Decimal(12, 2)
  diaDelMes    Int // 1 a 28
  desdePeriodo String // "AAAA-MM"
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  categoria CategoriaGasto @relation(fields: [categoriaId], references: [id])
  cuenta    Cuenta         @relation(fields: [cuentaId], references: [id])
  empleado  Empleado?      @relation(fields: [empleadoId], references: [id])
  gastos    Gasto[]
}

model Gasto {
  id              Int       @id @default(autoincrement())
  categoriaId     Int
  tipo            TipoGasto
  cuentaId        Int
  empleadoId      Int?
  recurrenteId    Int?
  periodo         String? // "AAAA-MM", solo en gastos que vienen de un recurrente
  creadoPorId     Int?
  monto           Decimal   @db.Decimal(12, 2)
  fecha           DateTime  @default(now())
  descripcion     String?
  anulado         Boolean   @default(false)
  anuladoEn       DateTime?
  motivoAnulacion String?

  categoria       CategoriaGasto   @relation(fields: [categoriaId], references: [id])
  cuenta          Cuenta           @relation(fields: [cuentaId], references: [id])
  empleado        Empleado?        @relation(fields: [empleadoId], references: [id])
  recurrente      GastoRecurrente? @relation(fields: [recurrenteId], references: [id])
  creadoPor       Usuario?         @relation(fields: [creadoPorId], references: [id])
  movimientosCaja MovimientoCaja[]

  @@index([fecha])
  @@index([categoriaId])
}
